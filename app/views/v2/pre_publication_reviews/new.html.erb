<% content_for :title, page_title %>

<% content_for :back_link,
   render("govuk_publishing_components/components/back_link", {
     href: edit_v2_document_edition_date_range_path(@document, @edition),
   }) %>

<% if @check_content_error_copy %>
  <%= render "govuk_publishing_components/components/error_summary", {
    title: "There is a problem",
    items: [{
      text: @check_content_error_copy,
      href: "#edition_has_checked_content" }],
  } %>
<% end %>

<div id="edition_<%= @edition.id %>">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <%= render(
            Edition::Show::V2::ReviewSummaryCardComponent.new(edition: @edition),
          ) %>

      <%= render(
            Edition::Show::V2::TimePeriodDateRangeSummaryCardComponent.new(edition: @edition),
          ) %>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
     <%= form_with(
        model: @edition,
        url: v2_document_edition_pre_publication_reviews_path(@document, @edition),
        method: :post,
      ) do %>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <%= render "govuk_publishing_components/components/checkboxes", {
          name: "edition[has_checked_content]",
          id: "edition_has_checked_content",
          heading: "Confirm",
          visually_hide_heading: true,
          no_hint_text: true,
          error: @check_content_error_copy,
          items: [
            {
              label: I18n.t("v2.edition.pre_publication_review.confirm"),
              value: true,
            },
          ],
        } %>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <%= render "govuk_publishing_components/components/button", {
          text: "Create",
          type: "submit",
        } %>
      </div>
    </div>
  <% end %>
</div>
