<ul class="actions govuk-list govuk-!-text-align-centre">
  <li>
    <% if finalised_state? %>
      <%= render "govuk_publishing_components/components/button", {
        text: has_more_recent_draft? ?
                I18n.t("v2.document.show.buttons.latest_edition") :
                I18n.t("v2.document.show.buttons.new_edition", block_type: @document.block_type.humanize.downcase),
        href: has_more_recent_draft? ?
                "edit latest edition - not implemented" :
                "new edition for document - not implemented",
      } %>
    <% else %>
      <%= render "govuk_publishing_components/components/button", {
        text: draft? ? I18n.t("v2.document.show.buttons.finalised_in_draft") : I18n.t("v2.document.show.buttons.finalised_not_in_draft"),
        href: edit_v2_document_edition_path(@document, @edition),
        secondary_solid: draft? ? false : true,
        inline_layout: false,
      } %>
    <% end %>
  </li>

  <% if state != "published" && @document.has_published_edition? %>
    <li class="govuk-!-static-margin-top-3">
      <%= link_to(I18n.t("v2.document.show.links.published_edition"), "go to published edition - not implemented", class: "govuk-link") %>
    </li>
  <% end %>

  <% if state == "published" && has_more_recent_draft? %>
    <li class="govuk-!-static-margin-top-3">
      <%= link_to(I18n.t("v2.document.show.links.newer_draft_edition"), "return to most recent edition - not implemented", class: "govuk-link") %>
    </li>
  <% end %>
</ul>
